# python setup_demo.py 가 로컬용 .env 를 만들어 준다. 직접 만들 때는 이 파일을 복사해 값을 채운다.
# .env 는 커밋하지 않는다.

# ── 접속 주소 (비우면 괄호 안 기본값) ─────────────────────────────────
# nginx 가 여는 호스트 주소와 포트 (127.0.0.1 / 8443). 외부에서 직접 받으면 0.0.0.0 / 443
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8443
# nginx server_name 과 자체 서명 인증서 이름 (localhost). 배포 시 도메인
PORTAL_SERVER_NAME=localhost
# 공인 인증서를 쓰면 cert.pem·key.pem 이 있는 폴더 경로. 비우면 자체 서명 인증서를 만든다.
PORTAL_TLS_DIR=

# ── 필수 비밀값 ───────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# 거래소(RKX)의 MK_PARTNER_TOKEN 과 같은 값
PARTNER_TOKEN=
# 새 DB를 만들 때만 쓰는 초기 비밀번호
DEMO_ADMIN_PASSWORD=
DEMO_AGENT1_PASSWORD=
DEMO_AGENT2_PASSWORD=

# ── OpenAI (관리자 화면에서 등록한 키가 없을 때 쓰는 서버 기본값) ─────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_CALL_SUMMARY_MODEL=

# ── 녹취 저장 ─────────────────────────────────────────────────────────
# 비우면 RECORDINGS_PATH(기본 ./.local/recordings)에 저장한다.
S3_RECORDING_BUCKET=
AWS_REGION=ap-northeast-2
RECORDINGS_PATH=./.local/recordings

# ── 세션·보관 시간(분) ────────────────────────────────────────────────
STAFF_SESSION_MINUTES=30
CHAT_SESSION_MINUTES=60
ENTRY_CODE_MINUTES=5
WAV_MAX_MIB=10
CASE_RETENTION_MINUTES=5
